<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.1</Version>
    <GameDir Condition="'$(GameDir)' == ''">G:\SteamLibrary\steamapps\common\Slay the Spire 2</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameDir)/data_sts2_windows_x86_64/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDir)/data_sts2_windows_x86_64/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)/data_sts2_windows_x86_64/0Harmony.dll" Private="false" />
    <None Update="DrawPeek.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)/data_sts2_windows_x86_64/sts2.dll')" Text="Game not found. Set GameDir." />
  </Target>
</Project>
